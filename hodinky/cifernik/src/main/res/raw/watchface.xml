<?xml version="1.0" encoding="utf-8"?>
<!--
  Ciferník „Chata“ – Watch Face Format (systém ho kreslí sám, žádný vlastní kód = šetří baterii).
  Plátno 480 × 480, střed 240/240. Grafiku kreslí cifernik/grafika/generuj.py (polohy musí sedět s tímto souborem).
  Tři subdialy (152 × 152): vlevo nahoře napětí chaty (komplikace z aplikace Chata), vpravo nahoře baterie hodinek,
  dole teplota (komplikace Chata – teplota venku). Ukazatel = trojúhelník po obvodu (−135° … +135°), uprostřed velké číslo.
  Nahoře nejbližší východ / západ slunce, vlevo dole den (PO), vpravo dole datum (21/12). Písmo Saira Expanded (res/font/saira.ttf).
  Úsporný režim (AMBIENT): ciferník vypadá stejně, jen zmizí vteřinovka (a střed ukáže ocelovou krytku).
-->
<WatchFace width="480" height="480" clipShape="CIRCLE">
  <Metadata key="CLOCK_TYPE" value="ANALOG"/>
  <Metadata key="PREVIEW_TIME" value="10:08:34"/>

  <Scene backgroundColor="#ff000000">

    <!-- ===== podklad ===== -->
    <PartImage name="dial" x="0" y="0" width="480" height="480">
      <Image resource="dial"/>
    </PartImage>

    <!-- ===== den (vlevo dole) a datum (vpravo dole) ===== -->
    <PartText name="day" x="58" y="280" width="120" height="40">
      <Text align="CENTER">
        <Font family="saira" size="26" color="#ffebedf2">
          <Upper><Template>%s<Parameter expression="[DAY_OF_WEEK_S]"/></Template></Upper>
        </Font>
      </Text>
    </PartText>
    <PartText name="date" x="302" y="280" width="120" height="40">
      <Text align="CENTER">
        <Font family="saira" size="26" color="#ffebedf2"><Template>%s/%s<Parameter expression="[DAY]"/><Parameter expression="[MONTH]"/></Template></Font>
      </Text>
    </PartText>

    <!-- ===== baterie hodinek (vpravo nahoře) ===== -->
    <Group name="batSub" x="251" y="114" width="152" height="152">
      <PartImage name="batMarker" x="0" y="0" width="152" height="152" pivotX="0.5" pivotY="0.5">
        <Transform target="angle" value="-135 + 2.7 * clamp([BATTERY_PERCENT], 0, 100)"/>
        <Image resource="marker"/>
      </PartImage>
      <PartText name="batText" x="0" y="60" width="152" height="44">
        <Text align="CENTER">
          <Font family="saira" size="32" color="#ffffffff"><Template>%s%%<Parameter expression="[BATTERY_PERCENT]"/></Template></Font>
        </Text>
      </PartText>
    </Group>

    <!-- ===== teplota (dole) – komplikace „Chata – teplota venku“ (Open-Meteo); jde vyměnit za počasí Xiaomi ===== -->
    <ComplicationSlot name="temp" slotId="2" displayName="Teplota" x="164" y="264" width="152" height="152"
        supportedTypes="RANGED_VALUE SHORT_TEXT" isCustomizable="TRUE">
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT"
          primaryProvider="cz.petr.chatahodinky/cz.petr.chatahodinky.TempComplication" primaryProviderType="RANGED_VALUE"/>
      <BoundingOval x="0" y="0" width="152" height="152"/>
      <Complication type="RANGED_VALUE">
        <PartImage name="tempMarker" x="0" y="0" width="152" height="152" pivotX="0.5" pivotY="0.5">
          <Transform target="angle" value="-135 + 270 * (clamp([COMPLICATION.RANGED_VALUE_VALUE], [COMPLICATION.RANGED_VALUE_MIN], [COMPLICATION.RANGED_VALUE_MAX]) - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN])"/>
          <Image resource="marker"/>
        </PartImage>
        <PartText name="tempText" x="0" y="60" width="152" height="44">
          <Text align="CENTER">
            <Font family="saira" size="32" color="#ffffffff"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="SHORT_TEXT">
        <PartText name="tempShort" x="0" y="60" width="152" height="44">
          <Text align="CENTER">
            <Font family="saira" size="32" color="#ffffffff"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font>
          </Text>
        </PartText>
      </Complication>
    </ComplicationSlot>

    <!-- ===== CHATA: napětí solární baterie (vlevo nahoře, komplikace z aplikace Chata) ===== -->
    <ComplicationSlot name="chata" slotId="0" displayName="Chata – baterie" x="77" y="114" width="152" height="152"
        supportedTypes="RANGED_VALUE SHORT_TEXT" isCustomizable="TRUE">
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT"
          primaryProvider="cz.petr.chatahodinky/cz.petr.chatahodinky.VoltComplication" primaryProviderType="RANGED_VALUE"/>
      <BoundingOval x="0" y="0" width="152" height="152"/>
      <Complication type="RANGED_VALUE">
        <PartImage name="chataMarker" x="0" y="0" width="152" height="152" pivotX="0.5" pivotY="0.5">
          <Transform target="angle" value="-135 + 270 * (clamp([COMPLICATION.RANGED_VALUE_VALUE], [COMPLICATION.RANGED_VALUE_MIN], [COMPLICATION.RANGED_VALUE_MAX]) - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN])"/>
          <Image resource="marker_chata"/>
        </PartImage>
        <PartText name="chataText" x="0" y="60" width="152" height="44">
          <Text align="CENTER">
            <Font family="saira" size="32" color="#ffffffff"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="SHORT_TEXT">
        <PartText name="chataShort" x="0" y="60" width="152" height="44">
          <Text align="CENTER">
            <Font family="saira" size="32" color="#ffffffff"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font>
          </Text>
        </PartText>
      </Complication>
    </ComplicationSlot>

    <!-- ===== nejbližší východ / západ slunce (nahoře) =====
         Z aplikace Chata jako RANGED_VALUE: hodnota 1 = příští je východ, 0 = západ; text = čas.
         Ikonky jsou přímo v ciferníku (spolehlivější než obrázek z komplikace). -->
    <ComplicationSlot name="sun" slotId="1" displayName="Slunce" x="110" y="74" width="260" height="36"
        supportedTypes="RANGED_VALUE SHORT_TEXT" isCustomizable="TRUE">
      <DefaultProviderPolicy defaultSystemProvider="SUNRISE_SUNSET" defaultSystemProviderType="SHORT_TEXT"
          primaryProvider="cz.petr.chatahodinky/cz.petr.chatahodinky.SunComplication" primaryProviderType="RANGED_VALUE"/>
      <BoundingBox x="0" y="0" width="260" height="36"/>
      <Complication type="RANGED_VALUE">
        <Group name="sunIcon" x="60" y="1" width="34" height="34">
          <Condition>
            <Expressions>
              <Expression name="up"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] > 0.5]]></Expression>
            </Expressions>
            <Compare expression="up">
              <Group name="sunUpG" x="0" y="0" width="34" height="34">
                <PartImage name="sunUp" x="0" y="0" width="34" height="34"><Image resource="sun_up"/></PartImage>
              </Group>
            </Compare>
            <Default>
              <Group name="sunDownG" x="0" y="0" width="34" height="34">
                <PartImage name="sunDown" x="0" y="0" width="34" height="34"><Image resource="sun_down"/></PartImage>
              </Group>
            </Default>
          </Condition>
        </Group>
        <PartText name="sunTime" x="102" y="0" width="158" height="36">
          <Text align="START">
            <Font family="saira" size="26" color="#ffe0e8f2"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="SHORT_TEXT">
        <PartText name="sunShort" x="0" y="0" width="260" height="36">
          <Text align="CENTER">
            <Font family="saira" size="26" color="#ffe0e8f2"><Template>%s %s<Parameter expression="[COMPLICATION.TITLE]"/><Parameter expression="[COMPLICATION.TEXT]"/></Template></Font>
          </Text>
        </PartText>
      </Complication>
    </ComplicationSlot>

    <!-- ===== ručky ===== -->
    <AnalogClock x="0" y="0" width="480" height="480">
      <HourHand resource="hand_hour" x="217" y="111" width="46" height="258" pivotX="0.5" pivotY="0.5">
      </HourHand>
      <MinuteHand resource="hand_minute" x="220" y="36" width="40" height="408" pivotX="0.5" pivotY="0.5">
      </MinuteHand>
      <!-- vteřinovka skáče po vteřině (bez plynulého pohybu = méně překreslování) a v úsporném režimu zmizí -->
      <SecondHand resource="hand_second" x="223" y="22" width="34" height="436" pivotX="0.5" pivotY="0.5">
        <Variant mode="AMBIENT" target="alpha" value="0"/>
      </SecondHand>
    </AnalogClock>

    <!-- středová krytka v úsporném režimu (jinak je součástí vteřinovky) -->
    <PartImage name="ambCap" x="228" y="228" width="24" height="24" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255"/>
      <Image resource="cap"/>
    </PartImage>

    <!-- diagonální odlesk sklíčka (nad vším) -->
    <PartImage name="glare" x="0" y="0" width="480" height="480">
      <Image resource="glare"/>
    </PartImage>
  </Scene>
</WatchFace>
